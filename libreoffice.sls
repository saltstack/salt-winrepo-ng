  {# The archived 7.2.5.2 MSIs omit the build number in their filenames. #}
  {% set filename_version = '7.2.5' if version == '7.2.5.2' else version %}
  '{{ version }}':
    full_name: 'LibreOffice {{ version }}'
    {% if grains['cpuarch'] == 'AMD64' %}
    {% set x64_suffix = 'x86-64' if version.split('.')[:2]|map('int')|list >= [7, 5] else 'x64' %}
    installer: 'https://downloadarchive.documentfoundation.org/libreoffice/old/{{ version }}/win/x86_64/LibreOffice_{{ filename_version }}_Win_{{ x64_suffix }}.msi'
    uninstaller: 'https://downloadarchive.documentfoundation.org/libreoffice/old/{{ version }}/win/x86_64/LibreOffice_{{ filename_version }}_Win_{{ x64_suffix }}.msi'
    {% else %}
    installer: 'https://downloadarchive.documentfoundation.org/libreoffice/old/{{ version }}/win/x86/LibreOffice_{{ filename_version }}_Win_x86.msi'
    uninstaller: 'https://downloadarchive.documentfoundation.org/libreoffice/old/{{ version }}/win/x86/LibreOffice_{{ filename_version }}_Win_x86.msi'
    {% endif %}
    install_flags: '/qn /norestart'
    uninstall_flags: '/qn /norestart'
    msiexec: True
    locale: en_US
    reboot: False
  {% endfor %}
